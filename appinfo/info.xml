<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>flzroom</id>
    <name>Filzmann Raumplaner</name>
    <summary>Monatliche Raumbelegung und kollisionsfreie Raumbuchungen.</summary>
    <description>Verwaltet Räume und eigene beziehungsweise administrative Buchungen in einer kompakten Monatsmatrix.</description>
    <version>0.13.0-rc.1</version>
    <licence>agpl</licence>
    <author>Filzmann Software</author>
    <namespace>FlzRoom</namespace>
    <category>organization</category>
    <website>https://github.com/Filzmann/flz-full-suite</website>
    <bugs>https://github.com/Filzmann/nextcloud-flzroom/issues</bugs>
    <repository type="git">https://github.com/Filzmann/nextcloud-flzroom</repository>
    <dependencies>
        <php min-version="8.3"/>
        <nextcloud min-version="33" max-version="34"/>
    </dependencies>
    <commands>
        <command>OCA\FlzRoom\Command\SeedDemoCommand</command>
    </commands>
    <settings>
        <admin>OCA\FlzRoom\Settings\Admin</admin>
        <admin-section>OCA\FlzRoom\Settings\AdminSection</admin-section>
    </settings>
</info>
